# JanSwasthya AI — Backend Environment Variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env` itself.

# --- App ---
ENVIRONMENT=development

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database ---
DATABASE_URL=postgresql://janswasthya:devpassword@postgres:5432/janswasthya_db
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
JWT_SECRET_KEY=your-generated-secret-here
QDRANT_COLLECTION=health_knowledge_base

# --- AI / LLM ---
# LLM_PROVIDER: "local" for self-hosted (Ollama/vLLM serving Mistral/Llama/Gemma),
# "openai_compatible" for any hosted provider exposing an OpenAI-style API.
LLM_PROVIDER=local
LLM_MODEL_NAME=mistral-7b-instruct
LLM_API_BASE=http://localhost:11434/v1
LLM_API_KEY=

EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-mpnet-base-v2

# --- RAG Guardrails ---
RAG_MIN_CONFIDENCE=0.55
RAG_TOP_K=5

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=30

# --- CORS ---
ALLOWED_ORIGINS=["http://localhost:3000"]
